# Finish the voxel cache after all preprocess.sub shards are done (CPU, minutes):
# merges the shard reports into report.json and writes metadata.json (train / val / test split + channel statistics).
# Refuses to run while a shard still holds its lock, and refuses when metadata.json already exists.
#   CONFIG default configs/preprocess_192.yaml
#   condor_submit /data/user/qwang/corsika_sparse_v2/jobs/preprocess_finalize.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/preprocess_192.yaml)"
getenv = True
arguments = "preprocess --finalize"
request_cpus = 2
request_memory = 16GB
request_disk = 4GB
request_gpus = 0
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_preprocess_finalize.$(Cluster).$(Process).out
error = v2_preprocess_finalize.$(Cluster).$(Process).err
log = v2_preprocess_finalize.$(Cluster).log
queue 1
