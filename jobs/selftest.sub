# Synthetic end-to-end run of the whole v2 chain on CPU (configs/smoke.yaml).
# Checks the wiring only; the data are SYNTHETIC.  Ends with "SELFTEST PASS".
# Writes ./smoke_run under the project directory (deleted and rebuilt on every run).
#   cd /scratch/qwang/corsika_sparse_v2
#   condor_submit /data/user/qwang/corsika_sparse_v2/jobs/selftest.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "selftest"
request_cpus = 4
request_memory = 8GB
request_disk = 4GB
request_gpus = 0
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_selftest.$(Cluster).$(Process).out
error = v2_selftest.$(Cluster).$(Process).err
log = v2_selftest.$(Cluster).log
stream_output = True
stream_error = True
queue 1
