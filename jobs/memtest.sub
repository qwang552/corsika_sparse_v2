# Peak GPU memory and seconds per step of ae / dit / struct / attr on the
# largest cached event -> artifacts/memtest/<gpu>_<date>.json.
# Only the dit uses a random latent here; the others use truth fields (no trained model needed).
#   CONFIG config file (default configs/v2.yaml)   KINDS models to test (default "ae dit struct attr")
#   condor_submit /data/user/qwang/corsika_sparse_v2/jobs/memtest.sub
#   condor_submit KINDS="struct attr" /data/user/qwang/corsika_sparse_v2/jobs/memtest.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "memtest --kinds $(KINDS:ae dit struct attr)"
request_cpus = 2
request_memory = 16GB
request_disk = 4GB
request_gpus = 1
# capability 6.0 to 8.9: GTX 1080 (6.1) up to A40 / Ada; excludes the 4 GB GTX 980 (5.2) and Hopper / Blackwell (9.0 and up)
requirements = (GPUs_Capability >= 6.0) && (GPUs_Capability < 9.0)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_memtest.$(Cluster).$(Process).out
error = v2_memtest.$(Cluster).$(Process).err
log = v2_memtest.$(Cluster).log
stream_output = True
stream_error = True
queue 1
