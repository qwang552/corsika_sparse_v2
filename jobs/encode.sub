# Encode every event with the trained AE -> artifacts/<case>/latents/
# plus the 8 D4 variants of the train latents when encode.d4 = true (off by default).
# Refuses to mix with a cache written by a different AE checkpoint.
#   CONFIG config file (default configs/v2.yaml)   CASE output sub-directory (default v2a)
#   CKPT   best | last (default best)
#   condor_submit /data/user/qwang/corsika_sparse_v2/jobs/encode.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "encode --case $(CASE:v2a) --checkpoint $(CKPT:best)"
request_cpus = 2
request_memory = 16GB
request_disk = 8GB
request_gpus = 1
# capability 6.0 to 8.9: GTX 1080 (6.1) up to A40 / Ada; excludes the 4 GB GTX 980 (5.2) and Hopper / Blackwell (9.0 and up)
requirements = (GPUs_Capability >= 6.0) && (GPUs_Capability < 9.0)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_encode.$(Cluster).$(Process).out
error = v2_encode.$(Cluster).$(Process).err
log = v2_encode.$(Cluster).log
stream_output = True
stream_error = True
queue 1
