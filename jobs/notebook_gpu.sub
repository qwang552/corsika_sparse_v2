# Same as notebook_cpu.sub on a GPU, for notebooks that run models (report.ipynb section 3,
# the AE cells of viz.ipynb).
#   NB     notebook (default notebooks/viz.ipynb)
#   EXTRA  more --set options; notebooks ignore CONFIG, so pass EXTRA="--set CONFIG=..."
#   condor_submit NB=notebooks/viz.ipynb /data/user/qwang/corsika_sparse_v2/jobs/notebook_gpu.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "notebook $(NB:notebooks/viz.ipynb) --threads 2 --set DEVICE=cuda $(EXTRA:)"
request_cpus = 2
request_memory = 16GB
request_disk = 4GB
request_gpus = 1
# capability 6.0 to 8.9: GTX 1080 (6.1) up to A40 / Ada; excludes the 4 GB GTX 980 (5.2) and Hopper / Blackwell (9.0 and up)
requirements = (GPUs_Capability >= 6.0) && (GPUs_Capability < 9.0)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_nb_gpu.$(Cluster).$(Process).out
error = v2_nb_gpu.$(Cluster).$(Process).err
log = v2_nb_gpu.$(Cluster).log
stream_output = True
stream_error = True
queue 1
