# Generate showers with one chain, split over NSHARD GPU jobs (queue NSHARD).
#   CHAIN  sa_truth | sa_recon | sdedit | full     RUN  run name under <case>/samples/
#   N      samples (paired chains: the first N test events; full: N unconditional samples)
#   EXTRA  "--sigma-start 1.0" for sdedit, "--t2 off" to switch off T2 (per-48^3-cell photon
#          rescaling), "--events 13 28" ...
#   CONFIG config file (default configs/v2.yaml)   CASE output sub-directory (default v2a)
#   CKPT   best | last (default best)     SEED (default 0)     NSHARD parallel jobs (default 4)
# Existing sample files are skipped (an evicted shard resumes); a RUN made with other
# settings or checkpoints is refused, so pick a new RUN for new settings.
#   condor_submit CHAIN=sa_recon RUN=sa_recon /data/user/qwang/corsika_sparse_v2/jobs/sample.sub
#   condor_submit CHAIN=sdedit RUN=sdedit_1 EXTRA="--sigma-start 1" NSHARD=2 /data/user/qwang/corsika_sparse_v2/jobs/sample.sub
#   condor_submit CHAIN=full RUN=full N=1000 NSHARD=10 /data/user/qwang/corsika_sparse_v2/jobs/sample.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "sample --case $(CASE:v2a) --chain $(CHAIN:sa_recon) --run $(RUN:sa_recon) --n-samples $(N:128) --seed $(SEED:0) --checkpoint $(CKPT:best) --shard $(Process) --num-shards $(NSHARD:4) $(EXTRA:)"
request_cpus = 2
request_memory = 16GB
request_disk = 4GB
request_gpus = 1
# capability 6.0 to 8.9: GTX 1080 (6.1) up to A40 / Ada; excludes the 4 GB GTX 980 (5.2) and Hopper / Blackwell (9.0 and up)
requirements = (GPUs_Capability >= 6.0) && (GPUs_Capability < 9.0)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_sample_$(RUN:sa_recon).$(Cluster).$(Process).out
error = v2_sample_$(RUN:sa_recon).$(Cluster).$(Process).err
log = v2_sample_$(RUN:sa_recon).$(Cluster).log
stream_output = True
stream_error = True
queue $(NSHARD:4)
