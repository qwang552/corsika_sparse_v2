# Active voxels vs grid resolution from the raw parquet (CPU only, no GPU).
# Output: artifacts/active_vs_grid/ (timestamped name if it already exists).
#   CONFIG config file (default configs/v2.yaml)   EVENTS events (default 300)
#   GRIDS  grid sizes (default 32,48,64,96,128,192,256,384)
#   condor_submit /data/user/qwang/corsika_sparse_v2/jobs/active_vs_grid.sub
#   condor_submit EVENTS=500 GRIDS=64,96,128,192,256 /data/user/qwang/corsika_sparse_v2/jobs/active_vs_grid.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/scripts/active_vs_grid.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "--events $(EVENTS:300) --grids $(GRIDS:32,48,64,96,128,192,256,384)"
request_cpus = 1
request_memory = 16GB
request_disk = 2GB
request_gpus = 0
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_active_vs_grid.$(Cluster).$(Process).out
error = v2_active_vs_grid.$(Cluster).$(Process).err
log = v2_active_vs_grid.$(Cluster).log
stream_output = True
stream_error = True
queue 1
