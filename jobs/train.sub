# Train one model of the v2 chain (GPU).  Resubmitting the same command resumes from
# <kind>_last.pt; a changed scientific setting is refused (use a new CASE instead).
#   KIND  ae | dit | struct | attr            (default ae)
#   CONFIG config file                         (default configs/v2.yaml)
#   CASE  output sub-directory                 (default v2a)
#   EXTRA extra cli options, e.g. "--steps 2000" or "--n-events 2000"
# Order: ae first; then encode.sub; then dit, struct, attr (independent of each other).
#   cd /scratch/qwang/corsika_sparse_v2
#   condor_submit KIND=ae /data/user/qwang/corsika_sparse_v2/jobs/train.sub
#   condor_submit KIND=struct /data/user/qwang/corsika_sparse_v2/jobs/train.sub
project = /data/user/qwang/corsika_sparse_v2
env_activate = /data/user/qwang/env/env2025/bin/activate
universe = vanilla
executable = $(project)/run_pipeline.sh
environment = "SPARSE_PROJECT=$(project) SPARSE_ENV=$(env_activate) SPARSE_CONFIG=$(CONFIG:configs/v2.yaml)"
getenv = True
arguments = "train --kind $(KIND:ae) --case $(CASE:v2a) $(EXTRA:)"
request_cpus = 4
request_memory = 16GB
request_disk = 4GB
request_gpus = 1
# capability 6.0 to 8.9: GTX 1080 (6.1) up to A40 / Ada; excludes the 4 GB GTX 980 (5.2) and Hopper / Blackwell (9.0 and up)
requirements = (GPUs_Capability >= 6.0) && (GPUs_Capability < 9.0)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
transfer_output_files = ""
output = v2_train_$(KIND:ae).$(Cluster).$(Process).out
error = v2_train_$(KIND:ae).$(Cluster).$(Process).err
log = v2_train_$(KIND:ae).$(Cluster).log
stream_output = True
stream_error = True
queue 1
